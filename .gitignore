# Byte-compiled / Python files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Data directory (keep raw excluded, track processed features CSV for cloud deployment)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/semiconductor_equipment_features.csv

# Models directory (track serialized model binaries and metadata for cloud deployment)
models/*
!models/.gitkeep
!models/*.json
!models/*.joblib

# Notebook checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE & Operating System specific files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs & temporary files
*.log
scratch/
