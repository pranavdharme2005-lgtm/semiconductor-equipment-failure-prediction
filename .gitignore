# Byte-compiled / Python files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Data directory (ignore data files, keep folder structure)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Models directory (ignore serialized binary model files, keep metadata and folder structure)
models/*
!models/.gitkeep
!models/*.json
*.joblib
*.pkl
*.onnx
*.h5

# Notebook checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE & Operating System specific files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs & temporary files
*.log
scratch/
